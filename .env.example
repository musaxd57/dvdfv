# Copy to .env and fill in. Never commit your real .env.

# One Etherscan V2 key works for ALL chains (ETH=1, Arbitrum=42161, etc.)
# Get a free key: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# --- optional overrides (sensible defaults in wallet_tracker.py) ---
# TARGET=0x20c2d95a3dfdca9e9ad12794d5fa6fad99da44f5
# DEPTH=3
# BIG_TRANSFER=10000
# MAX_TX_PER_ADDR=500
